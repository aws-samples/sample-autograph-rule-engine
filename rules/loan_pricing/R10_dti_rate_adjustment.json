{
  "rule_id": "R10",
  "name": "DTI Rate Adjustment",
  "description": "Adjust rate based on DTI tier. Higher debt burden = higher rate premium.",
  "inputs": ["dti_tier"],
  "outputs": ["dti_rate_adj"],
  "conditions": [],
  "action": {
    "type": "lookup",
    "entries": [
      {"condition": {"field": "dti_tier", "op": "eq", "value": "LOW"},        "result":  0.0000},
      {"condition": {"field": "dti_tier", "op": "eq", "value": "ACCEPTABLE"}, "result":  0.0025},
      {"condition": {"field": "dti_tier", "op": "eq", "value": "ELEVATED"},   "result":  0.0075},
      {"condition": {"field": "dti_tier", "op": "eq", "value": "HIGH"},       "result":  0.0150}
    ],
    "default_result": 0.0100
  },
  "priority": 6,
  "tags": ["rate", "adjustment", "dti"]
}